#!/usr/bin/env bash
# Unified backup entrypoint (sync + extras + one git commit/push).
#
# Usage: backup [-s] [--secrets] [--cursor-auth]
#   -s             sudo-only steps (sfltool login items; prompts for password if needed)
#   --secrets      also run offsite-secrets.sh (encrypted bundle)
#   --cursor-auth  also run cursor-auth-backup.sh (Cursor login/MCP tokens)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin:${HOME}/.local/bin:${PATH:-}"
# shellcheck source=scripts/_common.sh
source "$ROOT/scripts/_common.sh"

usage() {
    cat <<EOF
Usage: $(basename "$0") [-s] [--secrets] [--cursor-auth] [-h]

  (no args)      sync dotfiles/configs/packages + extras; skip sudo-only steps
  -s             include sudo-only steps (sfltool; will prompt for password if needed)
  --secrets      also encrypt secrets bundle → <target>/secrets/bundle.zip.age (+ Drive)
  --cursor-auth  also encrypt Cursor auth → <target>/cursor-auth/cursor-auth-bundle.tar.age
  -h             this help

Tool repo: $ROOT
Data repo: \$BACKUP_ROOT (from manifest/backup-run.conf)
EOF
}

BACKUP_SUDO=0
BACKUP_SECRETS=0
BACKUP_CURSOR_AUTH=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        -s) BACKUP_SUDO=1; shift ;;
        --secrets) BACKUP_SECRETS=1; shift ;;
        --cursor-auth) BACKUP_CURSOR_AUTH=1; shift ;;
        -h | --help) usage; exit 0 ;;
        *)
            echo "backup: unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

export BACKUP_SUDO

BACKUP_RUN_BIN="${BACKUP_RUN_BIN:-}"
if [[ -z "$BACKUP_RUN_BIN" ]]; then
    if command -v backup-run >/dev/null 2>&1; then
        BACKUP_RUN_BIN="$(command -v backup-run)"
    elif [[ -x "${HOME}/.local/bin/backup-run" ]]; then
        BACKUP_RUN_BIN="${HOME}/.local/bin/backup-run"
    elif [[ -x "${ROOT}/.venv/bin/backup-run" ]]; then
        BACKUP_RUN_BIN="${ROOT}/.venv/bin/backup-run"
    fi
fi
if [[ -z "$BACKUP_RUN_BIN" ]]; then
    echo "backup: backup-run not found — pipx install --force $ROOT" >&2
    exit 1
fi

BACKUP_REPO_ROOT="${BACKUP_REPO_ROOT:-$(resolve_backup_repo_root)}"
BACKUP_ROOT="${BACKUP_ROOT:-$(resolve_backup_root)}"
BACKUP_TARGET="${BACKUP_TARGET:-$(run_tool_python -c 'from backup_run.config import get_backup_target; print(get_backup_target())')}"
export BACKUP_REPO_ROOT BACKUP_ROOT BACKUP_TARGET

if [[ "$BACKUP_ROOT" == "$BACKUP_REPO_ROOT" ]]; then
    echo "backup: BACKUP_ROOT equals repo root — set BACKUP_TARGET in ~/.zsh/local.sh" >&2
    exit 1
fi

echo "==> backup: target=$BACKUP_TARGET path=$BACKUP_ROOT"
echo "==> backup: sync ($BACKUP_RUN_BIN)"
"$BACKUP_RUN_BIN" --backup-all --no-splash --no-new-backup-path-prompt --skip-git

echo "==> backup: extras"
"$ROOT/scripts/backup_extras.sh"

if [[ "$BACKUP_SECRETS" -eq 1 ]]; then
    echo "==> backup: secrets"
    "$ROOT/scripts/offsite-secrets.sh" --verify
fi

if [[ "$BACKUP_CURSOR_AUTH" -eq 1 ]]; then
    echo "==> backup: cursor-auth"
    "$ROOT/scripts/cursor-auth-backup.sh" --verify
fi

if git -C "$BACKUP_REPO_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "$BACKUP_REPO_ROOT" add -A
    if ! git -C "$BACKUP_REPO_ROOT" diff --cached --quiet; then
        echo "==> backup: commit ($BACKUP_TARGET)"
        git -C "$BACKUP_REPO_ROOT" commit -m "backup: snapshot $BACKUP_TARGET"
    fi
    if git -C "$BACKUP_REPO_ROOT" rev-parse '@{u}' >/dev/null 2>&1; then
        ahead="$(git -C "$BACKUP_REPO_ROOT" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)"
        if [[ "$ahead" != "0" ]]; then
            echo "==> backup: push"
            git -C "$BACKUP_REPO_ROOT" push
        fi
    fi
fi

echo "==> backup: done → $BACKUP_ROOT (repo: $BACKUP_REPO_ROOT, target: $BACKUP_TARGET)"
